[
  {
    "comment": "Layout actions in Zed's keymap format (context, then keystroke -> action). `cmd` means Cmd on macOS and Ctrl elsewhere. Keys follow design/layout.md. MinimizePane, ReopenFocusLayout and the dock toggles have no key there, so they stay unbound (reachable from the pane menu, the status bar and the focus-history button). On integration these bindings move into app/keymap/default.json.",
    "context": "LayoutLab",
    "bindings": {
      "cmd-k m": "chorong::ToggleMaximizePane",
      "cmd-k p": "chorong::PinContextHere",
      "cmd-k shift-p": "chorong::PinContextToBottomBar",
      "escape": "chorong::RestoreLayout",
      "cmd-k f": "chorong::ToggleFrameStats"
    }
  },
